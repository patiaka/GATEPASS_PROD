# VCS / editor
.git
.gitignore
.gitattributes
.idea
.vscode

# Dependencies (installed inside the image)
node_modules
vendor

# Local env & secrets — set these in Dokploy instead
.env
.env.*
!.env.example

# Runtime / caches (recreated in the container)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# Dev-only / not needed at runtime
tests
docs
*.md
phpunit.xml
.editorconfig
Dockerfile
.dockerignore
docker-compose.yml
