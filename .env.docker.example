# =====================================================================
#  GatePass — environment for Dokploy (copy these into Dokploy's env UI)
#  Do NOT commit real secrets. This file is a template only.
# =====================================================================

APP_NAME="GatePass"
APP_ENV=production
# Reuse your CURRENT production APP_KEY so existing encrypted data/sessions stay valid.
# Generate a new one with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://gatepass.domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---- Database : Microsoft SQL Server -------------------------------
DB_CONNECTION=sqlsrv
DB_HOST=
DB_PORT=1433
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# ODBC Driver 18 encrypts by default; trust the server cert if it is self-signed.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=true

# ---- Sessions / cache / queue / storage ----------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true            # served over HTTPS via Traefik
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# database queue → the "worker" service IS required (the jobs table already exists).
QUEUE_CONNECTION=database

# Redis is NOT used (cache=file, session=file, queue=database). No Redis service needed
# unless you switch one of those drivers to "redis" — then add a Redis service.

# ---- Mail (internal SMTP relay — used for password resets & notifications) ----
MAIL_MAILER=smtp
MAIL_HOST=192.168.84.103              # the Dokploy server must reach this host on the LAN
MAIL_PORT=25
MAIL_USERNAME=null                   # relay without auth
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null                 # no TLS on port 25
MAIL_FROM_ADDRESS="Gatepass-noreply@somisy.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Deployment toggles --------------------------------------------
# Set to true ONCE to run migrations on boot, then set back to false.
RUN_MIGRATIONS=false
